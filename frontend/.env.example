# Public API origin reachable from the customer's browser (Cloud Run / Fly.io Go API URL in production)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Canonical public website URL used for OpenGraph, canonical links, sitemap.xml, and robots.txt.
# On Vercel set this to the production domain (e.g. https://your-shop.vercel.app). When it is
# unset, deployment builds fall back to the VERCEL_URL of the running deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal / server-side API URL used by Next.js Server Components during SSR and metadata fetching
API_INTERNAL_URL=http://localhost:8080

# Optional Google Search Console verification token (the content value of the HTML tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional public Cloudinary cloud name for client URL display helpers (API key/secret remain strictly server-side in Go)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
