# Server
PORT=8080
APP_ENV=development
APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017

MONGODB_DB_NAME=teestore

# Authentication & Security (leave empty in dev for ephemeral secrets, set strong 32+ char secrets in prod)
JWT_SECRET=replace_with_a_64_character_random_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_64_character_random_hex_string
ADMIN_PASSCODE=choose_a_strong_admin_passcode


# Cloudinary Image Storage (server-side signing & deletion)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=teestore/products
